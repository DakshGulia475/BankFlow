PORT=4000
NODE_ENV=development
# A replica set (even single-node) is required for multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/bankflow?replicaSet=rs0
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/bankflow_test?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
